# Copy this file to .env and replace placeholders locally or in your host's
# secret manager. Never commit the resulting .env file.
MEDIMATE_ENVIRONMENT=development
MEDIMATE_DATABASE_URL=sqlite:///./medimate.db
MEDIMATE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Production example (do not put a real password in this template):
# MEDIMATE_DATABASE_URL=postgresql+psycopg://medimate:REPLACE_ME@db:5432/medimate


